root = true
# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# 4 space indentation
[*.ts]
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 100

# Matches the exact files either package.json or .travis.yml
[package.json]
indent_style = space
indent_size = 2
